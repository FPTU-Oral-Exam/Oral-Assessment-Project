        <mxCell id="1" parent="0" />
        <mxCell id="3" value="&lt;b&gt;ACTIVITY DIAGRAM: Giai đoạn 5: AI Worker Chấm điểm Tự động (Batch Assessment)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:11px;color:#64748b;&#x27;&gt;Hệ thống Thi Vấn đáp Tự động Bằng AI (OralAI) — Hướng 2&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Worker khởi chạy" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="475" y="70" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="5" value="1. Celery Worker quét submissions có status = &#x27;UPLOADED&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;fontSize=11;fontStyle=0;align=center;spacing=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="150" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="6" value="2. Tải file Audio raw minh chứng từ MinIO Storage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;fontSize=11;fontStyle=0;align=center;spacing=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="230" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="7" value="3. ASR Whisper: Trích xuất Transcript + Timestamps từng từ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;fontSize=11;fontStyle=0;align=center;spacing=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="310" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="8" value="4. Trích xuất chỉ số Âm học (Fluency Metrics):
Tốc độ nói wps, ngập ngừng, false starts, số lần ngắt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;fontSize=11;fontStyle=0;align=center;spacing=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="390" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="9" value="5. Điều phối chấm theo dạng câu hỏi (Part 1 -&gt; Part 6):
- Read Aloud (RA) &amp; Repeat Sentence (RS)
- Describe Image (DI) &amp; Re-tell Lecture (RL)
- Answer Short Question (ASQ) &amp; Group Discussion (SGD)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#7c3aed;strokeColor=#6d28d9;fontColor=#ffffff;fontSize=11;fontStyle=0;align=center;spacing=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="480" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="10" value="6. Tính toán điểm chi tiết: Content, Fluency, Pronunciation
Quy đổi sang thang điểm PTE 10-90 và thang 10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;fontSize=11;fontStyle=0;align=center;spacing=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="580" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="11" value="7. Sinh nhận xét AI Feedback tự động theo Rubric" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;fontSize=11;fontStyle=0;align=center;spacing=4;shadow=1;" vertex="1" parent="1">
