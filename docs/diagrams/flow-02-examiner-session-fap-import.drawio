        <mxCell id="3" value="&lt;b&gt;ACTIVITY DIAGRAM: Giai đoạn 2: Cán bộ Khảo thí Tổ chức Ca thi &amp; Import FAP / Nhập tay&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:11px;color:#64748b;&#x27;&gt;Hệ thống Thi Vấn đáp Tự động Bằng AI (OralAI) — Hướng 2&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
