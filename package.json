{
  "name": "ai-oral-assessment-platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/staff-portal",
    "apps/student-app"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/staff-portal",
    "dev:staff": "npm run dev -w apps/staff-portal",
    "dev:student": "npm run dev -w apps/student-app",
    "student": "npm run electron:dev -w apps/student-app",
    "student:web": "npm run dev -w apps/student-app",
    "desktop": "npm run electron:dev -w apps/student-app",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w apps/student-app",
    "build": "npm run build -w apps/student-app",
    "test": "npm run test:run -w packages/shared && npm run test:run -w apps/student-app",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "electron": "^33.4.11",
    "prettier": "^3.3.3"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
